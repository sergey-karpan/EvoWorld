<Window x:Class="EvoWorld.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="EvoWorld" Width="960" Height="760" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#151B24">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="12">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="StartButton" Content="Start" Click="Start_Click" Padding="16,6" Margin="0,0,8,0" />
                <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" Padding="16,6" Margin="0,0,8,0" IsEnabled="False" />
                <Button x:Name="ResetButton" Content="Reset" Click="Reset_Click" Padding="16,6" Margin="0,0,16,0" />
                <ComboBox x:Name="ControllerSelector" Width="205" Margin="0,0,8,0" VerticalAlignment="Center"
                          SelectedIndex="0" ToolTip="Changes take effect on Reset." SelectionChanged="ExperimentSelection_Changed">
                    <ComboBoxItem Content="Rule-based (Task 9)" />
                    <ComboBoxItem Content="Neural (Tasks 11b–11c)" />
                </ComboBox>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mutation:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="MutationSelector" Width="65" Margin="0,0,12,0" VerticalAlignment="Center" IsEnabled="False"
                              ToolTip="Neural weight mutation amplitude at birth; 0 disables mutation. Changes take effect on Reset."
                              SelectionChanged="ExperimentSelection_Changed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Predators:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="PredatorSelector" Width="55" Margin="0,0,12,0" VerticalAlignment="Center"
                              ToolTip="Initial predators added to 20 herbivores. Changes take effect on Reset."
                              SelectionChanged="ExperimentSelection_Changed" />
                </StackPanel>
                <ComboBox x:Name="TraitSelector" Width="130" VerticalAlignment="Center"
                          ToolTip="Organism color trait" SelectionChanged="TraitSelector_SelectionChanged" />
            </WrapPanel>
            <TextBlock x:Name="ConfigurationText" Foreground="#C4CFDC" Margin="0,6,0,2" TextWrapping="Wrap" />
            <TextBlock x:Name="TickText" Text="Tick: 0" Foreground="White" TextWrapping="Wrap" />
            <TextBlock x:Name="StatisticsText" Foreground="#C4CFDC" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Text="Ready" Foreground="#C4CFDC" Margin="12,8" TextWrapping="Wrap" />
        <TextBlock x:Name="LegendText" DockPanel.Dock="Bottom" Foreground="#C4CFDC" Margin="12,4" TextWrapping="Wrap">
            <Run Text="Herbivores: trait fill · " />
            <Run Text="Predators: purple outline" Foreground="#D568FF" />
            <Run Text=" · Food: green" Foreground="#73DB79" />
            <Run Text=" · Inspection: gold ring/trail" Foreground="#FFD166" />
            <LineBreak />
            <Run Text="Click an organism to inspect; click empty space to clear" />
        </TextBlock>
        <DockPanel x:Name="WorldArea" SizeChanged="WorldArea_SizeChanged">
            <Border x:Name="InspectorPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="#202B38" Margin="12,4" Padding="8">
                <ScrollViewer x:Name="InspectorScroll" MaxHeight="185" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Gold ring: selected organism · Translucent gold line: sampled trajectory" Foreground="#FFD166" TextWrapping="Wrap" />
                        <TextBlock x:Name="InspectorText" Foreground="#DEF7FF" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <skia:SKElement x:Name="Viewport" PaintSurface="Viewport_PaintSurface" SizeChanged="Viewport_SizeChanged" MouseLeftButtonDown="Viewport_MouseLeftButtonDown" />
        </DockPanel>
    </DockPanel>
</Window>
