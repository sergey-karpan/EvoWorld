<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 4.x defaults to MTP; retain the approved VSTest adapter path. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/EvoWorld.Desktop/ViewportTransform.cs" Link="Desktop/ViewportTransform.cs" />
    <Compile Include="../../src/EvoWorld.Desktop/ExperimentSettings.cs" Link="Desktop/ExperimentSettings.cs" />
    <Compile Include="../../src/EvoWorld.Desktop/DesktopExperiment.cs" Link="Desktop/DesktopExperiment.cs" />
    <ProjectReference Include="../../src/EvoWorld.Core/EvoWorld.Core.csproj" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
  </ItemGroup>
</Project>
